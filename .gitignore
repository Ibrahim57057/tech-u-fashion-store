# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables — never commit secrets.
# The secret values live in Render's dashboard for production and in
# apps/backend/.env locally. See apps/backend/.gitignore as well; both are
# needed because this file is the one that covers the repo root.
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?