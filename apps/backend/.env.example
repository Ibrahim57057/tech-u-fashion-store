# Template for apps/backend/.env — copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored and never deployed. Production values live in Render's
# dashboard instead, not in a file.
#
# Nothing here is a real secret. Generate real values, never reuse these.

# Must be set in production or the app refuses to start.
# Render injects this itself; never set it locally.
# NODE_ENV=production

# MongoDB Atlas connection string.
# In production, add Render's outbound IPs to the Atlas IP Access List, or set
# the list to 0.0.0.0/0 to accept connections from anywhere. An access list
# that does not allow Render is the most common cause of a deploy that builds
# fine and then cannot reach the database.
MONGO_URI=

# Signing key for session tokens. Must be at least 32 characters in
# production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this logs everyone out.
JWT_SECRET=

# Where the frontend is served, e.g. http://localhost:5173.
# CORS only allows these origins. Comma-separate for several:
#   CLIENT_URL=https://a.example.com,https://b.example.com
# Must NOT be localhost in production — the app refuses to start if it is.
CLIENT_URL=http://localhost:5173

# Live-mode keys, never the test/live mix-ups.
PAYSTACK_SECRET_KEY=
RESEND_API_KEY=

# Optional. Without these, product image upload returns an error; every other
# feature still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port the API listens on. Render injects this automatically.
# PORT=4000