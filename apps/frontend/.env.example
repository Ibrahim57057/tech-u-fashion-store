# Template for apps/frontend/.env — copy to .env and fill in.
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser bundle, which
# is also why a secret must never be added here: anything in this file ends up
# in the shipped JavaScript that every visitor can read.

# Base URL of the backend API, including the /api/v1 prefix.
#
# Local development:  http://localhost:4000/api/v1
# Production:         https://<your-api-service>.onrender.com/api/v1
#
# Vite inlines this at BUILD time, not at runtime. Setting it on Render's
# frontend service requires a new build to take effect — a restart or a
# redeploy of the same commit is not enough.
#
# If this is missing, the app falls back to http://localhost:4000/api/v1,
# which works on your machine and nowhere else.
VITE_API_URL=http://localhost:4000/api/v1